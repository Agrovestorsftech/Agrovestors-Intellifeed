# Sign-in mode.
# - demo (default): any email + 6-character password; all data is local
#   mock data (src/lib/mock). Needs no other variables.
# - api: real dashboard sign-in against the IntelliFeed360 backend (session
#   cookie, emailed code on a new device). Data screens still use mock data
#   until each one is connected.
# VITE_AUTH_MODE=api

# Local development (npm run dev): the dev server forwards /api to this
# backend so the session cookie works on localhost. Leave VITE_API_BASE_URL
# unset in development, or requests will skip the forwarding and sign-in
# will fail.
# VITE_API_PROXY_TARGET=https://api-testing-intellifeed360.onrender.com

# Deployed builds only: the API base URL, including /api/v1. It must be on
# the same domain as the dashboard (e.g. https://api.<domain>/api/v1 for a
# dashboard on https://agents.<domain>), or browsers won't send the cookie.
# VITE_API_BASE_URL=https://api.<domain>/api/v1
#
# Vercel without a custom domain: vercel.json forwards /api to the testing
# API, so the cookie stays on the dashboard's own domain. Set in Vercel:
#   VITE_AUTH_MODE=api
#   VITE_API_BASE_URL=/api/v1
# and add the Vercel address (https://<project>.vercel.app) to the API's
# CSRF_TRUSTED_ORIGINS on Render. Without VITE_AUTH_MODE=api the build runs
# in demo mode: sample data, and nothing reaches the backend.
