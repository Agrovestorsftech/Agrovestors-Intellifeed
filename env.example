# IntelliFeed360 API base URL (includes /api/v1)
VITE_API_BASE_URL=https://api-testing-intellifeed360.onrender.com/api/v1

# Show the OTP code returned by the backend (SHOW_RANDOM_OTP) on the login
# screen. Always on in `npm run dev`; set to true only for staging/test
# deployments. NEVER enable in production.
# VITE_SHOW_TEST_OTP=true

# Supabase vars below are no longer required for data access — they're
# being phased out entirely per MIGRATION_PLAN.md. Left here only until
# Phase 9 removes the Supabase integration files.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
